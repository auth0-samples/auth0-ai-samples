# Auth0 Configuration

# Auth0 tenant domain (e.g., your-tenant.us.auth0.com)
AUTH0_DOMAIN=your-tenant.auth0.com

# Auth0 API Identifier - must match the identifier of your Auth0 API exactly, including the trailing slash
AUTH0_AUDIENCE=http://localhost:3001/

# Port the server will listen on
PORT=3001

# CORS origins - comma-separated list of allowed origins (* for all)
CORS_ORIGINS=*
